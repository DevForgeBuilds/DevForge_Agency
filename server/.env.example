# ============================================================
# SERVER
# ============================================================
PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================================
# MONGODB
# ============================================================
# Local example: mongodb://127.0.0.1:27017/devforge
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/devforge
MONGO_URI=mongodb://devforgebuilds_db_user:C7F1QnpoiVCudVUr@ac-jgscoxn-shard-00-00.j5r5i9g.mongodb.net:27017,ac-jgscoxn-shard-00-01.j5r5i9g.mongodb.net:27017,ac-jgscoxn-shard-00-02.j5r5i9g.mongodb.net:27017/devforge?ssl=true&replicaSet=atlas-5z9fkw-shard-0&authSource=admin&appName=Cluster0
# ============================================================
# JWT (admin login)
# ============================================================
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ============================================================
# SMTP (email notifications) - example uses Gmail
# For Gmail: enable 2-Step Verification, then create an "App Password"
# https://myaccount.google.com/apppasswords
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=devforge.builds@gmail.com
SMTP_PASS=zehc ifin xqam vssa

# Address the "new inquiry" notification is sent to (your inbox)
ADMIN_EMAIL=devforge.builds@gmail.com

# "From" address shown on outgoing emails
EMAIL_FROM="DevForge <devforge.builds@gmail.com>"

# ============================================================
# SEED ADMIN (used once by `npm run seed:admin`)
# ============================================================
ADMIN_SEED_EMAIL=devforge.builds@gmail.com
ADMIN_SEED_PASSWORD=change_this_password
